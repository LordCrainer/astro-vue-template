---
import "@styles/global.css";
import SiteHeader from "@organisms/SiteHeader.vue";
import SiteFooter from "@organisms/SiteFooter.vue";
import WhatsAppButton from "@organisms/WhatsAppButton.vue";
import { siteContact, siteName } from "@lib/navigation";
import { t, defaultLocale } from "@lib/i18n";

const content = t();

interface Props {
  title: string;
  description?: string;
  /** Ruta a una imagen 1200x630 para OG/Twitter. Cae a un valor por defecto si no se pasa. */
  image?: string;
  noindex?: boolean;
}

const {
  title,
  description = content.site.defaultDescription,
  image = "/og-default.jpg",
  noindex = false,
} = Astro.props;

const currentPath = Astro.url.pathname;
const pageTitle = `${title} · ${siteName}`;
const canonicalUrl = new URL(currentPath, Astro.site);
const ogImageUrl = new URL(image, Astro.site);

/**
 * JSON-LD genérico como ejemplo — cambiar "@type" según el proyecto real:
 * "Organization" (empresa), "LocalBusiness" (negocio físico),
 * "Person" (marca personal) o algo más específico según el rubro real.
 */
const organizationJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: siteName,
  description,
  url: Astro.site?.toString(),
  telephone: siteContact.phoneValue,
};
---

<!doctype html>
<html lang={defaultLocale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (function () {
        try {
          if (localStorage.getItem("theme") === "dark") {
            document.documentElement.setAttribute("data-theme", "dark");
          }
        } catch (_) {}
      })();
    </script>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/png" href="/logo-cagm.png" />
    <title>{pageTitle}</title>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="es_ES" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(organizationJsonLd)}
    />
  </head>
  <body>
    <a href="#main-content" class="skip-link">{content.a11y.skipToContent}</a>
    <SiteHeader currentPath={currentPath} client:load />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter client:visible />
    <WhatsAppButton client:visible />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: -100%;
    left: var(--space-4);
    z-index: 100;
    padding: var(--space-3) var(--space-5);
    background-color: var(--brand-secondary);
    color: var(--text-inverse);
    border-radius: var(--radius-sm);
    font-weight: var(--weight-semibold);
    transition: top var(--transition-fast);
  }

  .skip-link:focus-visible {
    top: var(--space-4);
  }
</style>
