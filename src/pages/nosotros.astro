---
import BaseLayout from "@layouts/BaseLayout.astro";
import SimplePageTemplate from "@templates/SimplePageTemplate.astro";
import BaseHeading from "@atoms/BaseHeading.vue";
import BaseText from "@atoms/BaseText.vue";
import { t } from "@lib/i18n";

const content = t();
---

<BaseLayout title={content.nav.about} description={content.about.metaDescription}>
  <SimplePageTemplate title={content.about.pageTitle} intro={content.about.pageIntro}>
    <div class="values">
      <article class="values__card">
        <BaseHeading :level="2" size="sm" tone="brand" client:visible>
          {content.about.missionTitle}
        </BaseHeading>
        <BaseText client:visible>
          {content.about.missionText}
        </BaseText>
      </article>
      <article class="values__card values__card--inverse">
        <BaseHeading :level="2" size="sm" tone="inverse" client:visible>
          {content.about.visionTitle}
        </BaseHeading>
        <BaseText tone="inverse" client:visible>
          {content.about.visionText}
        </BaseText>
      </article>
    </div>
  </SimplePageTemplate>
</BaseLayout>

<style>
  .values {
    display: grid;
    gap: var(--space-5);
    max-width: 40rem;
  }

  .values__card {
    padding: var(--space-5);
    border-radius: var(--radius-md);
    background-color: var(--surface-muted);
    box-shadow: var(--shadow-sm);
  }

  .values__card--inverse {
    background-color: var(--brand-secondary);
  }
</style>
