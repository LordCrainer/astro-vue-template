---
import BaseLayout from "@layouts/BaseLayout.astro";
import SimplePageTemplate from "@templates/SimplePageTemplate.astro";
import TeamMemberCard from "@molecules/TeamMemberCard.vue";
import { t } from "@lib/i18n";

const content = t();
---

<BaseLayout title={content.nav.team} description={content.team.metaDescription}>
  <SimplePageTemplate title={content.team.pageTitle} intro={content.team.pageIntro}>
    <div class="team-list">
      {
        content.team.members.map((member) => (
          <TeamMemberCard
            name={member.name}
            jobTitle={member.jobTitle}
            href={"href" in member ? member.href : undefined}
            client:visible
          >
            {member.bio}
          </TeamMemberCard>
        ))
      }
    </div>
  </SimplePageTemplate>
</BaseLayout>

<style>
  .team-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
</style>
