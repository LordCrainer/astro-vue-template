---
import BaseLayout from "@layouts/BaseLayout.astro";
import SimplePageTemplate from "@templates/SimplePageTemplate.astro";
import ServicesGrid from "@organisms/ServicesGrid.vue";
import { t } from "@lib/i18n";

const content = t();
---

<BaseLayout title={content.nav.services} description={content.services.metaDescription}>
  <SimplePageTemplate title={content.services.pageTitle} intro={content.services.pageIntro}>
    <ServicesGrid services={content.services.items} client:visible />
  </SimplePageTemplate>
</BaseLayout>
