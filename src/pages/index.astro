---
import BaseLayout from "@layouts/BaseLayout.astro";
import HeroSection from "@organisms/HeroSection.vue";
import ServicesGrid from "@organisms/ServicesGrid.vue";
import BaseHeading from "@atoms/BaseHeading.vue";
import BaseText from "@atoms/BaseText.vue";
import { services } from "@lib/data/services";
import { siteName } from "@lib/navigation";
---

<BaseLayout
  title="Inicio"
  description="Desarrollo de software a medida: aplicaciones web rápidas, accesibles y fáciles de mantener."
>
  <HeroSection
    eyebrow="Desarrollo de software a medida"
    title={siteName.toUpperCase()}
    highlight="DESARROLLO DE SOFTWARE"
    description="Construyo productos web rápidos, accesibles y fáciles de mantener, de principio a fin."
    ctaLabel="Contactar"
    ctaHref="/contacto"
    client:visible
  />

  <section class="container section">
    <BaseHeading :level="2" size="lg" client:visible>
      Nuestros servicios
    </BaseHeading>
    <BaseText tone="muted" client:visible>
      Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod
      tempor incididunt.
    </BaseText>
    <div class="section__grid">
      <ServicesGrid services={services} client:visible />
    </div>
  </section>
</BaseLayout>

<style>
  .section {
    padding-block: var(--space-10);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .section__grid {
    margin-top: var(--space-5);
  }
</style>
