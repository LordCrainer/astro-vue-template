---
import BaseLayout from "@layouts/BaseLayout.astro";
import SimplePageTemplate from "@templates/SimplePageTemplate.astro";
import ResourceCard from "@molecules/ResourceCard.vue";
import { t } from "@lib/i18n";

const content = t();
---

<BaseLayout title={content.nav.resources} description={content.resources.metaDescription}>
  <SimplePageTemplate title={content.resources.pageTitle} intro={content.resources.pageIntro}>
    <div class="resources-grid">
      {
        content.resources.items.map((entry) => (
          <ResourceCard
            term={entry.term}
            definition={entry.definition}
            client:visible
          />
        ))
      }
    </div>
  </SimplePageTemplate>
</BaseLayout>

<style>
  .resources-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
  }

  @media (min-width: 720px) {
    .resources-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
